generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String  @id @default(cuid())
  name                   String
  email                  String  @unique
  passwordHash           String
  role                   Role    @default(ORGANISER)
  paystackSubaccountCode String?

  events Event[]

  eventStaff   EventStaff[]
  invitedStaff StaffInvitation[] @relation("StaffInvitationsSent")

  createdAt DateTime @default(now())
}

model Event {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  description   String
  state         String
  venue         String
  date          DateTime
  startTime     String
  endTime       String
  category      String
  status        EventStatus @default(live)
  featured      Boolean     @default(false)
  trending      Boolean     @default(false)
  coverGradient String
  coverImageUrl String?
  tags          String[]    @default([])
  refundPolicy  String?
  minAge        Int?

  organiserId String
  createdAt   DateTime @default(now())

  eventStaff       EventStaff[]
  staffInvitations StaffInvitation[]

  attendees       Attendee[]
  customQuestions CustomQuestion[]

  organiser         User               @relation(fields: [organiserId], references: [id])
  listingFeePayment ListingFeePayment?
  orders            Order[]
  ticketTypes       TicketType[]

  @@index([state])
  @@index([category])
  @@index([organiserId])
  @@index([date])
}

model EventStaff {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model StaffInvitation {
  id          String    @id @default(cuid())
  email       String
  eventId     String
  invitedById String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("StaffInvitationsSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([eventId])
}

model TicketType {
  id               String @id @default(cuid())
  name             String
  price            Int
  quantityTotal    Int
  quantitySold     Int    @default(0)
  eventId          String
  quantityReserved Int    @default(0)

  attendees  Attendee[]
  orderItems OrderItem[]

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model CustomQuestion {
  id       String   @id @default(cuid())
  label    String
  type     String   @default("text")
  options  String[] @default([])
  required Boolean  @default(false)
  eventId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id          String @id @default(cuid())
  reference   String @unique
  paystackRef String @unique

  name  String
  email String
  phone String

  amount           Int
  ticketAmount     Int @default(0)
  serviceFee       Int @default(0)
  organiserAmount  Int @default(0)
  commissionAmount Int @default(0)
  platformFee      Int @default(0)

  status PaymentStatus @default(pending)

  expiresAt DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  eventId       String
  customAnswers Json?

  attendees Attendee[]
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([eventId])
  @@index([status])
  @@index([email])
}

model OrderItem {
  id           String @id @default(cuid())
  quantity     Int
  unitPrice    Int
  orderId      String
  ticketTypeId String

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
}

model Attendee {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String
  ticketId      String        @unique
  amountPaid    Int
  purchaseDate  DateTime      @default(now())
  paymentStatus PaymentStatus @default(pending)
  checkInStatus Boolean       @default(false)
  checkInTime   DateTime?
  ticketStatus  TicketStatus  @default(active)
  customAnswers Json?

  eventId      String
  ticketTypeId String
  orderId      String?

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  transaction Transaction?

  @@index([eventId])
  @@index([email])
  @@index([orderId])
}

model Transaction {
  id          String        @id @default(cuid())
  amount      Int
  platformFee Int
  status      PaymentStatus @default(pending)
  date        DateTime      @default(now())

  attendeeId String @unique

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
}

model ListingFeePayment {
  id          String        @id @default(cuid())
  eventId     String        @unique
  amount      Int
  paystackRef String        @unique
  status      PaymentStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum Role {
  ORGANISER
  CHECKIN_STAFF
  ADMIN
}

enum EventStatus {
  live
  pending
  disabled
  archived
}

enum PaymentStatus {
  paid
  pending
  failed
}

enum TicketStatus {
  active
  used
  transferred
  cancelled
}
